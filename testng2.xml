<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

	<test name="Payment Tests">
		<groups>
			<run>
				<include name="payment" />
				<include name="smoke" />
			</run>
		</groups>
		<classes>
			<class name="Tests.PaymentTestsUsingDataprovider" />
		</classes>
	</test>

	<test name="Regression Tests">
		<classes>
			<class name="Tests.PaymentTest" />
			<class name="testCases.LoginTest" />
			<class name="testCases.LoginTest2" />
			<class name="Tests.PaymentTestsUsingDataprovider" />
		</classes>
	</test>

</suite>